  "issues": {
    "new_api_key": {
      "title": "{title} needs a new PoolCop API key",
      "description": "Version 3.0 of the PoolCop integration uses the new PoolCop Client API, because the PoolCopilot API is shutting down. Your existing key does not work with it.\n\nLog in to [MyPoolCop]({api_key_url}), open **Profile → API key**, click **Generate a key**, and enter it when Home Assistant asks you to re-authenticate {title}. This message disappears once the new key works."
    },
    "cloud_access_expired": {
      "title": "PoolCop cloud access expired for {title}",
      "description": "PoolCop reports that the cloud access for {title} has expired, so Home Assistant cannot read or control it. Renew the cloud access in MyPoolCop or contact your PoolCop dealer. This message disappears once the device is reachable again."
    }
  },
  "services": {
    "set_pump_speed": {
      "name": "Set pump speed",
      "description": "Sets the pump speed.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        },
        "speed": {
          "name": "Speed",
          "description": "Pump speed: 0 is off, 1 to 8 are the speeds your pump supports."
        }
      }
    },
    "toggle_pump": {
      "name": "Toggle pump",
      "description": "Turns the pump on if it is off, or off if it is on.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        }
      }
    },
    "toggle_aux": {
      "name": "Toggle auxiliary",
      "description": "Turns an auxiliary output on if it is off, or off if it is on.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        },
        "aux_id": {
          "name": "Auxiliary",
          "description": "The auxiliary output number."
        },
        "module": {
          "name": "Module",
          "description": "The extension module of the output; None for the PoolCop itself."
        }
      }
    },
    "set_valve_position": {
      "name": "Set valve position",
      "description": "Turns the multiport valve to a position.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        },
        "position": {
          "name": "Position",
          "description": "The valve position."
        }
      }
    },
    "clear_alarm": {
      "name": "Clear alarm",
      "description": "Clears one alarm, or all active alarms.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        },
        "alarm_code": {
          "name": "Alarm code",
          "description": "The alarm to clear, for example PressureLowPump1. Leave empty to clear all alarms."
        }
      }
    },
    "stop_backwash": {
      "name": "Stop backwash",
      "description": "Stops a backwash in progress.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        }
      }
    },
    "set_filtration_mode": {
      "name": "Set filtration mode",
      "description": "Sets the filtration mode, keeping the current cycle times.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        },
        "mode": {
          "name": "Mode",
          "description": "The filtration mode."
        }
      }
    },
    "set_filtration_timers": {
      "name": "Set filtration timers",
      "description": "Sets the filtration cycle times and, optionally, the filtration mode. Settings you leave out keep their current value.",
      "fields": {
        "config_entry_id": {
          "name": "PoolCop",
          "description": "The PoolCop to control. Required when more than one is configured."
        },
        "mode": {
          "name": "Mode",
          "description": "The filtration mode. Defaults to the current mode."
        },
        "cycle_1_enabled": {
          "name": "Cycle 1 enabled",
          "description": "Whether filtration cycle 1 runs."
        },
        "cycle_1_start": {
          "name": "Cycle 1 start",
          "description": "Start time of filtration cycle 1."
        },
        "cycle_1_end": {
          "name": "Cycle 1 end",
          "description": "End time of filtration cycle 1."
        },
        "cycle_2_enabled": {
