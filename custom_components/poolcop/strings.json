{
  "config": {
    "step": {
      "user": {
        "title": "Connect to PoolCop",
        "description": "Enter your PoolCop Client API key. Log in to [MyPoolCop]({api_key_url}), open **Profile → API key** and click **Generate a key**. One key covers every PoolCop on your account.",
        "data": {
          "api_key": "API key"
        },
        "data_description": {
          "api_key": "The PoolCop Client API key from MyPoolCop. Keys for the old PoolCopilot API do not work."
        }
      },
      "device": {
        "title": "Choose a PoolCop",
        "description": "Your account has more than one PoolCop. Choose the one to add; you can add the others afterwards with the same key.",
        "data": {
          "device_id": "PoolCop"
        }
      },
      "flow_rates": {
        "title": "Pump flow rates",
        "description": "Your pump has {pump_speeds} speed(s). Enter the flow rate at each speed; it is used to calculate filtered volume and turnovers.\n\nPool volume: {vol} m³\nEstimated flow rate reported by PoolCop: {flowrate} m³/h",
        "data": {
          "flow_rate_1": "Flow rate at speed 1",
          "flow_rate_2": "Flow rate at speed 2",
          "flow_rate_3": "Flow rate at speed 3"
        }
      },
      "reauth_confirm": {
        "title": "New PoolCop API key needed",
        "description": "The API key for {title} was rejected. Since version 3.0 this integration uses the PoolCop Client API, which needs a new key: log in to [MyPoolCop]({api_key_url}), open **Profile → API key** and click **Generate a key**.",
        "data": {
          "api_key": "API key"
        },
        "data_description": {
          "api_key": "The PoolCop Client API key from MyPoolCop. Keys for the old PoolCopilot API do not work."
        }
      },
      "reconfigure": {
        "title": "Change the API key",
        "description": "Enter a new API key for {title}. Get one in [MyPoolCop]({api_key_url}) under **Profile → API key**.",
        "data": {
          "api_key": "API key"
        },
        "data_description": {
          "api_key": "The PoolCop Client API key from MyPoolCop. Keys for the old PoolCopilot API do not work."
        }
      }
    },
    "abort": {
      "already_configured": "Every PoolCop on this account is already configured",
      "cannot_connect": "Failed to connect",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful"
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid API key",
      "no_devices": "No PoolCop devices found for this API key",
      "device_not_found": "This API key cannot access this PoolCop. Use a key from the account that owns it.",
      "unknown": "Unexpected error"
    }
  },
